#include <ctype.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <math.h>
#include <string.h>
#include <errno.h>

// Prototipi funzioni helper
double inputValue(void);
char* realToString(double value);

int main(void) {
    int op, i;
    double a, b, result;

    op = 1;
    while (op != 0) {
        printf("\n=== Calculadora Cientifica + IMC e Area ===\n");
        printf("1:Soma | 2:Subtracao | 3:Multiplicacao | 4:Divisao | 5:Potencia | 6:Modulo\n");
        printf("7:Raiz | 8:Seno | 9:Cosseno | 10:Tangente | 11:Asin | 12:Acos | 13:Atan\n");
        printf("14:Log10 | 15:Ln | 16:Exp | 17:Abs | 18:Int | 19:Sinal | 20:Fatorial\n");
        printf("21:Calculo de IMC | 22:Area do Retangulo/Triangulo\n");
        printf("0:Sair\n");
        printf("--------------------------------------------------\n");
        printf("Escolha a operacao (0 a 22): ");
        fflush(stdout); // Garante a exibicao do menu no GDB antes do input

        op = (int) inputValue();

        if (op > 0 && op <= 22) {
            if ((op >= 1 && op <= 6) || op == 21 || op == 22) {
                if (op == 21) {
                    printf("Digite o peso (kg): ");
                    fflush(stdout);
                    a = inputValue();
                    
                    printf("Digite a altura (m): ");
                    fflush(stdout);
                    b = inputValue();
                    
                    if (b > 0) {
                        result = (a / pow(b, 2));
                        if (result < 18.5) {
                            printf("Classificacao: Abaixo do peso\n");
                        } else if (result < 25.0) {
                            printf("Classificacao: Peso normal\n");
                        } else if (result < 30.0) {
                            printf("Classificacao: Sobrepeso (Acima do peso)\n");
                        } else {
                            printf("Classificacao: Obesidade\n");
                        }
                    } else {
                        printf("ERRO: Altura deve ser maior que zero!\n");
                        result = 0;
                    }
                } else if (op == 22) {
                    printf("Digite a Base: ");
                    fflush(stdout);
                    a = inputValue();
                    
                    printf("Digite a Altura: ");
                    fflush(stdout);
                    b = inputValue();
                    
                    result = (a * b);
                } else {
                    printf("Digite o valor de A: ");
                    fflush(stdout);
                    a = inputValue();
                    
                    printf("Digite o valor de B: ");
                    fflush(stdout);
                    b = inputValue();
                    
                    if (op == 1) result = (a + b);
                    if (op == 2) result = (a - b);
                    if (op == 3) result = (a * b);
                    if (op == 4) {
                        if (b != 0) {
                            result = (a / b);
                        } else {
                            printf("ERRO: Divisao por zero!\n");
                            result = 0;
                        }
                    }
                    if (op == 5) result = pow(a, b);
                    if (op == 6) {
                        if ((long long)b != 0) {
                            result = (double)((long long)a % (long long)b);
                        } else {
                            printf("ERRO: Modulo por zero!\n");
                            result = 0;
                        }
                    }
                }
            } else {
                printf("Digite o valor de A: ");
                fflush(stdout);
                a = inputValue();
                
                if (op == 7) result = sqrt(a);
                if (op == 8) result = sin(a);
                if (op == 9) result = cos(a);
                if (op == 10) result = tan(a);
                if (op == 11) result = asin(a);
                if (op == 12) result = acos(a);
                if (op == 13) result = atan(a);
                if (op == 14) result = log10(a);
                if (op == 15) result = log(a);
                if (op == 16) result = exp(a);
                if (op == 17) result = fabs(a);
                if (op == 18) result = (int)(a);
                if (op == 19) result = (a > 0 ? 1 : (a < 0 ? -1 : 0));
                if (op == 20) {
                    result = 1;
                    for (i = 1; i <= (int)(a); i++) {
                        result = (result * i);
                    }
                }
            }

            char* resStr = realToString(result);
            printf("=====> Resultado: %s\n\n", resStr);
            free(resStr); // Libera a memoria alocada
        } else {
            if (op != 0) {
                printf("Opcao Invalida!\n");
            }
        }
    }
    return 0;
}

// Funcoes de suporte para leitura segura e conversao
double inputValue(void) {
    char buffer[1024];
    for (;;) {
        if (fgets(buffer, sizeof(buffer), stdin) == NULL) {
            return 0.0;
        }
        size_t len = strlen(buffer);
        if (len > 0 && buffer[len - 1] == '\n') {
            buffer[len - 1] = '\0';
        }
        errno = 0;
        char* endptr;
        double value = strtod(buffer, &endptr);
        if (endptr != buffer && *endptr == '\0' && errno == 0) {
            return value;
        }
        fprintf(stderr, "Valore non valido. Inserire un numero.\n");
        fflush(stderr);
    }
}

char* realToString(double value) {
    char buffer[64];
    int len = snprintf(buffer, sizeof(buffer), "%g", value);
    if (len < 0) {
        fprintf(stderr, "Errore in realToString.\n");
        exit(EXIT_FAILURE);
    }
    char* result = (char*)malloc((size_t)len + 1);
    if (result == NULL) {
        fprintf(stderr, "Errore: memoria insufficiente in realToString.\n");
        exit(EXIT_FAILURE);
    }
    memcpy(result, buffer, (size_t)len + 1);
    return result;
}
