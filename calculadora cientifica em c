/**
 * @file calculadora_cientifica.c
 * @brief Calculadora Científica interativa em C com leitura segura de dados.
 */

#include <ctype.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <math.h>
#include <string.h>
#include <errno.h>

/* =========================================================================
 * PROTÓTIPOS DAS FUNÇÕES DE SUPORTE
 * ========================================================================= */

// Conversão simples de tipos
int toInt(const char* text);
double toReal(const char* text);
const char* toString(double value);

// Leitura segura e manipuladores de entrada/saída
double inputValue(void);
char* inputString(void);
bool inputBool(void);
char* stringConcat(const char* s1, const char* s2);
char* toChar(int code);
char* intToString(int value);
char* realToString(double value);
char* boolToString(bool value);

/* =========================================================================
 * FUNÇÃO PRINCIPAL (MAIN)
 * ========================================================================= */

int main(void) {
    int op, i;
    double a, b, result;

    op = 1;

    // Loop principal da calculadora (permanece até o usuário digitar 0)
    while (op != 0) {
        // Exibição do menu de opções
        printf("%s\n", "=== Calculadora Cientifica ===");
        printf("%s\n", "1:Soma | 2:Subtracao | 3:Multiplicacao | 4:Divisao | 5:Potencia | 6:Modulo");
        printf("%s\n", "7:Raiz | 8:Seno | 9:Cosseno | 10:Tangente | 11:Asin | 12:Acos | 13:Atan");
        printf("%s\n", "14:Log10 | 15:Ln | 16:Exp | 17:Abs | 18:Int | 19:Sinal | 20:Fatorial");
        printf("%s\n", "0:Sair");
        printf("%s\n", "--------------------------------");
        printf("%s\n", "Escolha a operacao (0 a 20):");

        // Leitura segura da opção
        op = (int) inputValue();

        if (op > 0 && op <= 20) {
            // Operações Binárias (Exigem 2 operandos: A e B)
            if (op >= 1 && op <= 6) {
                printf("%s\n", "Digite o valor de A:");
                a = inputValue();
                printf("%s\n", "Digite o valor de B:");
                b = inputValue();

                if (op == 1) {
                    result = (a + b);
                }
                if (op == 2) {
                    result = (a - b);
                }
                if (op == 3) {
                    result = (a * b);
                }
                if (op == 4) {
                    // Validação contra divisão por zero
                    if (b != 0) {
                        result = (a / b);
                    } else {
                        printf("%s\n", "ERRO: Divisao por zero!");
                        result = 0;
                    }
                }
                if (op == 5) {
                    result = pow(a, b);
                }
                if (op == 6) {
                    // Utiliza fmod() da math.h para suportar módulo entre números de ponto flutuante (double)
                    if (b != 0) {
                        result = fmod(a, b);
                    } else {
                        printf("%s\n", "ERRO: Modulo por zero!");
                        result = 0;
                    }
                }
            } 
            // Operações Unárias (Exigem apenas 1 operando: A)
            else {
                printf("%s\n", "Digite o valor de A:");
                a = inputValue();

                if (op == 7)  { result = sqrt(a); }                  // Raiz quadrada
                if (op == 8)  { result = sin(a); }                   // Seno
                if (op == 9)  { result = cos(a); }                   // Cosseno
                if (op == 10) { result = tan(a); }                   // Tangente
                if (op == 11) { result = asin(a); }                  // Arco Seno
                if (op == 12) { result = acos(a); }                  // Arco Cosseno
                if (op == 13) { result = atan(a); }                  // Arco Tangente
                if (op == 14) { result = log10(a); }                 // Logaritmo na base 10
                if (op == 15) { result = log(a); }                   // Logaritmo Natural (Ln)
                if (op == 16) { result = exp(a); }                   // Exponencial e^a
                if (op == 17) { result = fabs(a); }                  // Valor Absoluto |a|
                if (op == 18) { result = (int)(a); }                 // Truncamento para Inteiro
                if (op == 19) {                                      // Função Sinal
                    result = (a > 0 ? 1 : (a < 0 ? -1 : 0));
                }
                if (op == 20) {                                      // Cálculo de Fatorial
                    result = 1;
                    for (i = 1; i <= (int)(a); i++) {
                        result = (result * i);
                    }
                }
            }

            // Exibição do resultado formatado de forma limpa (sem vazamento de memória)
            printf("=====> Resultado: %g\n\n", result);

        } else {
            if (op != 0) {
                printf("%s\n", "Opcao Invalida!\n");
            }
        }
    }

    printf("Programa encerrado com sucesso.\n");
    return 0;
}

/* =========================================================================
 * IMPLEMENTAÇÃO DAS FUNÇÕES AUXILIARES
 * ========================================================================= */

/**
 * Converte uma string para inteiro usando a biblioteca padrão.
 */
int toInt(const char* text) {
    return atoi(text);
}

/**
 * Converte uma string para double usando a biblioteca padrão.
 */
double toReal(const char* text) {
    return atof(text);
}

/**
 * Converte um valor real para string utilizando buffer estático.
 */
const char* toString(double value) {
    static char buffer[64];
    snprintf(buffer, sizeof(buffer), "%g", value);
    return buffer;
}

/**
 * Leitura robusta do teclado: lê a linha e garante a validação do número double.
 */
double inputValue(void) {
    char buffer[1024];
    for (;;) {
        if (fgets(buffer, sizeof(buffer), stdin) == NULL) {
            return 0.0;
        }

        // Remove a quebra de linha (\n) do final do buffer
        size_t len = strlen(buffer);
        if (len > 0 && buffer[len - 1] == '\n') {
            buffer[len - 1] = '\0';
        }

        // Converte string para double e valida se todo o conteúdo era numérico
        errno = 0;
        char* endptr;
        double value = strtod(buffer, &endptr);
        if (endptr != buffer && *endptr == '\0' && errno == 0) {
            return value;
        }

        fprintf(stderr, "Valor invalido. Digite um numero valido:\n");
    }
}

/**
 * Concatena duas strings com alocação dinâmica de memória.
 */
char* stringConcat(const char* s1, const char* s2) {
    size_t len1 = (s1 != NULL) ? strlen(s1) : 0;
    size_t len2 = (s2 != NULL) ? strlen(s2) : 0;
    char* result = (char*)malloc(len1 + len2 + 1);

    if (result == NULL) {
        fprintf(stderr, "Erro: memoria insuficiente em stringConcat.\n");
        exit(EXIT_FAILURE);
    }

    if (s1 != NULL) {
        memcpy(result, s1, len1);
    }
    if (s2 != NULL) {
        memcpy(result + len1, s2, len2);
    }

    result[len1 + len2] = '\0';
    return result;
}

/**
 * Lê uma string digitada pelo usuário e aloca dinamicamente o tamanho necessário.
 */
char* inputString(void) {
    char buffer[1024];
    if (fgets(buffer, sizeof(buffer), stdin) == NULL) {
        char* empty = (char*)malloc(1);
        if (empty == NULL) {
            fprintf(stderr, "Erro: memoria insuficiente em inputString.\n");
            exit(EXIT_FAILURE);
        }
        empty[0] = '\0';
        return empty;
    }

    size_t len = strlen(buffer);
    if (len > 0 && buffer[len - 1] == '\n') {
        buffer[len - 1] = '\0';
        len--;
    }

    char* result = (char*)malloc(len + 1);
    if (result == NULL) {
        fprintf(stderr, "Erro: memoria insuficiente em inputString.\n");
        exit(EXIT_FAILURE);
    }

    memcpy(result, buffer, len + 1);
    return result;
}

/**
 * Lê uma entrada do usuário e valida se é booleana ("true" ou "false").
 */
bool inputBool(void) {
    char buffer[32];
    for (;;) {
        if (fgets(buffer, sizeof(buffer), stdin) == NULL) {
            return false;
        }

        size_t len = strlen(buffer);
        if (len > 0 && buffer[len - 1] == '\n') {
            buffer[len - 1] = '\0';
            len--;
        }

        int hasSpace = 0;
        for (size_t i = 0; i < len; i++) {
            if (buffer[i] == ' ' || buffer[i] == '\t') {
                hasSpace = 1;
                break;
            }
        }

        if (hasSpace) {
            fprintf(stderr, "Valor booleano invalido. Inserir true ou false.\n");
            continue;
        }

        // Valida a palavra "true" (Case Insensitive)
        if (len == 4) {
            int isTrue = 1;
            if (buffer[0] != 't' && buffer[0] != 'T') isTrue = 0;
            if (buffer[1] != 'r' && buffer[1] != 'R') isTrue = 0;
            if (buffer[2] != 'u' && buffer[2] != 'U') isTrue = 0;
            if (buffer[3] != 'e' && buffer[3] != 'E') isTrue = 0;
            if (isTrue) return true;
        }

        // Valida a palavra "false" (Case Insensitive)
        if (len == 5) {
            int isFalse = 1;
            if (buffer[0] != 'f' && buffer[0] != 'F') isFalse = 0;
            if (buffer[1] != 'a' && buffer[1] != 'A') isFalse = 0;
            if (buffer[2] != 'l' && buffer[2] != 'L') isFalse = 0;
            if (buffer[3] != 's' && buffer[3] != 'S') isFalse = 0;
            if (buffer[4] != 'e' && buffer[4] != 'E') isFalse = 0;
            if (isFalse) return false;
        }

        fprintf(stderr, "Valor booleano invalido. Inserir true ou false.\n");
    }
}

/**
 * Converte um código ASCII (inteiro) em uma string contendo um único caractere.
 */
char* toChar(int code) {
    char* result = (char*)malloc(2);
    if (result == NULL) {
        fprintf(stderr, "Erro: memoria insuficiente em toChar.\n");
        exit(EXIT_FAILURE);
    }
    result[0] = (char)code;
    result[1] = '\0';
    return result;
}

/**
 * Converte um número inteiro para uma string alocada dinamicamente.
 */
char* intToString(int value) {
    char buffer[32];
    int len = snprintf(buffer, sizeof(buffer), "%d", value);
    if (len < 0) {
        fprintf(stderr, "Erro em intToString.\n");
        exit(EXIT_FAILURE);
    }

    char* result = (char*)malloc((size_t)len + 1);
    if (result == NULL) {
        fprintf(stderr, "Erro: memoria insuficiente em intToString.\n");
        exit(EXIT_FAILURE);
    }

    memcpy(result, buffer, (size_t)len + 1);
    return result;
}

/**
 * Converte um número do tipo double para uma string alocada dinamicamente.
 */
char* realToString(double value) {
    char buffer[64];
    int len = snprintf(buffer, sizeof(buffer), "%g", value);
    if (len < 0) {
        fprintf(stderr, "Erro em realToString.\n");
        exit(EXIT_FAILURE);
    }

    char* result = (char*)malloc((size_t)len + 1);
    if (result == NULL) {
        fprintf(stderr, "Erro: memoria insuficiente em realToString.\n");
        exit(EXIT_FAILURE);
    }

    memcpy(result, buffer, (size_t)len + 1);
    return result;
}

/**
 * Converte um valor booleano para a string "true" ou "false".
 */
char* boolToString(bool value) {
    const char* src = value ? "true" : "false";
    size_t len = strlen(src);
    char* result = (char*)malloc(len + 1);

    if (result == NULL) {
        fprintf(stderr, "Erro: memoria insuficiente em boolToString.\n");
        exit(EXIT_FAILURE);
    }

    memcpy(result, src, len + 1);
    return result;
}
