// ============================================================
// FUNÇÃO PRINCIPAL
// ============================================================

int main(void) {

    // Declara duas variáveis inteiras.
    //
    // op = opção escolhida no menu.
    // i  = contador utilizado no cálculo do fatorial.
    int op, i;

    // Declara três variáveis do tipo double.
    //
    // a      = primeiro valor digitado.
    // b      = segundo valor digitado.
    // result = resultado da operação.
    double a, b, result;


    // Coloca 1 inicialmente na variável op.
    //
    // Isso faz com que o while possa começar.
    op = 1;


    // Enquanto op for diferente de 0,
    // o menu continuará sendo repetido.
    //
    // Quando o usuário escolher 0,
    // o while será encerrado.
    while (op != 0) {

        // Mostra o título da calculadora.
        printf("%s\n", "=== Calculadora Cientifica ===");

        // Mostra as operações de 1 até 6.
        printf("%s\n", "1:Soma | 2:Subtração | 3:Multiplicação | 4:Divisão | 5:Potência | 6:Módulo");

        // Mostra as operações de 7 até 13.
        printf("%s\n", "7:Raiz | 8:Seno | 9:Cosseno | 10:Tangente | 11:Asin | 12:Acos | 13:Atan");

        // Mostra as operações de 14 até 20.
        printf("%s\n", "14:Log10 | 15:Ln | 16:Exp | 17:Abs | 18:Int | 19:Sinal | 20:Fatorial");

        // Mostra a opção para sair.
        printf("%s\n", "0:Sair");

        // Mostra uma linha para separar o menu.
        printf("%s\n", "--------------------------------");

        // Pede para o usuário escolher uma operação.
        printf("%s\n", "Escolha a operacao (0 a 20):");

        // Lê o número digitado pelo usuário.
        //
        // inputValue() retorna um double.
        // (int) transforma esse valor em inteiro.
        // O valor finalmente é armazenado em op.
        op = (int) inputValue();


        // Verifica se a opção está entre 1 e 20.
        //
        // && significa "E".
        //
        // Portanto:
        // op precisa ser maior que 0
        // E
        // op precisa ser menor ou igual a 20.
        if (op > 0 && op <= 20) {


            // ====================================================
            // OPERAÇÕES QUE PRECISAM DE DOIS VALORES
            // ====================================================

            // Verifica se a operação está entre 1 e 6.
            //
            // Essas operações precisam de A e B.
            if (op >= 1 && op <= 6) {

                // Pede o primeiro valor.
                printf("%s\n", "Digite o valor de A:");

                // Lê o valor de A.
                a = inputValue();

                // Pede o segundo valor.
                printf("%s\n", "Digite o valor de B:");

                // Lê o valor de B.
                b = inputValue();


                // ------------------------------------------------
                // OPERAÇÃO 1 - SOMA
                // ------------------------------------------------

                // Se op for igual a 1,
                // realiza a soma.
                if (op == 1) {

                    // Soma A + B e guarda o resultado.
                    result = (a + b);
                }


                // ------------------------------------------------
                // OPERAÇÃO 2 - SUBTRAÇÃO
                // ------------------------------------------------

                // Se op for igual a 2,
                // realiza a subtração.
                if (op == 2) {

                    // Subtrai B de A.
                    result = (a - b);
                }


                // ------------------------------------------------
                // OPERAÇÃO 3 - MULTIPLICAÇÃO
                // ------------------------------------------------

                // Se op for igual a 3,
                // realiza a multiplicação.
                if (op == 3) {

                    // Multiplica A por B.
                    result = (a * b);
                }


                // ------------------------------------------------
                // OPERAÇÃO 4 - DIVISÃO
                // ------------------------------------------------

                // Se op for igual a 4,
                // realiza a divisão.
                if (op == 4) {

                    // Verifica se B é diferente de zero.
                    //
                    // != significa "diferente de".
                    if (b != 0) {

                        // Divide A por B.
                        result = (a / b);

                    } else {

                        // Se B for zero, mostra uma mensagem de erro.
                        printf("%s\n", "ERRO: Divisao por zero!");

                        // Coloca 0 como resultado.
                        result = 0;
                    }
                }


                // ------------------------------------------------
                // OPERAÇÃO 5 - POTÊNCIA
                // ------------------------------------------------

                // Se op for igual a 5,
                // calcula a potência.
                if (op == 5) {

                    // pow(a, b) significa A elevado a B.
                    //
                    // Exemplo:
                    // pow(2, 3) = 8
                    result = pow(a, b);
                }


                // ------------------------------------------------
                // OPERAÇÃO 6 - MÓDULO
                // ------------------------------------------------

                // Se op for igual a 6,
                // calcula o módulo/resto da divisão.
                if (op == 6) {

                    // Calcula o resto da divisão.
                    result = (a % b);
                }


            } else {

                // ====================================================
                // OPERAÇÕES QUE PRECISAM DE APENAS UM VALOR
                // ====================================================

                // Pede o valor de A.
                printf("%s\n", "Digite o valor de A:");

                // Lê o valor digitado.
                a = inputValue();


                // ------------------------------------------------
                // OPERAÇÃO 7 - RAIZ QUADRADA
                // ------------------------------------------------

                // Se op for 7,
                // calcula a raiz quadrada.
                if (op == 7) {

                    // sqrt() calcula a raiz quadrada.
                    result = sqrt(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 8 - SENO
                // ------------------------------------------------

                if (op == 8) {

                    // Calcula o seno de A.
                    result = sin(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 9 - COSSENO
                // ------------------------------------------------

                if (op == 9) {

                    // Calcula o cosseno de A.
                    result = cos(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 10 - TANGENTE
                // ------------------------------------------------

                if (op == 10) {

                    // Calcula a tangente de A.
                    result = tan(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 11 - ASIN
                // ------------------------------------------------

                if (op == 11) {

                    // Calcula o arco seno de A.
                    result = asin(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 12 - ACOS
                // ------------------------------------------------

                if (op == 12) {

                    // Calcula o arco cosseno de A.
                    result = acos(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 13 - ATAN
                // ------------------------------------------------

                if (op == 13) {

                    // Calcula o arco tangente de A.
                    result = atan(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 14 - LOG10
                // ------------------------------------------------

                if (op == 14) {

                    // Calcula o logaritmo na base 10.
                    result = log10(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 15 - LN
                // ------------------------------------------------

                if (op == 15) {

                    // log() calcula o logaritmo natural (ln).
                    result = log(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 16 - EXP
                // ------------------------------------------------

                if (op == 16) {

                    // exp(a) calcula e elevado a A.
                    result = exp(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 17 - ABS
                // ------------------------------------------------

                if (op == 17) {

                    // fabs() calcula o valor absoluto.
                    //
                    // Exemplo:
                    // fabs(-10) = 10
                    result = fabs(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 18 - INT
                // ------------------------------------------------

                if (op == 18) {

                    // (int) converte A para inteiro.
                    //
                    // Exemplo:
                    // 5.8 -> 5
                    result = (int)(a);
                }


                // ------------------------------------------------
                // OPERAÇÃO 19 - SINAL
                // ------------------------------------------------

                if (op == 19) {

                    // Operador ternário.
                    //
                    // Se A for maior que 0, resultado = 1.
                    //
                    // Caso contrário, verifica se A é menor que 0.
                    // Se for, resultado = -1.
                    //
                    // Caso contrário, resultado = 0.
                    result = (a > 0 ? 1 : (a < 0 ? -1 : 0));
                }


                // ------------------------------------------------
                // OPERAÇÃO 20 - FATORIAL
                // ------------------------------------------------

                if (op == 20) {

                    // O fatorial começa com 1.
                    result = 1;

                    // Laço for.
                    //
                    // i começa em 1.
                    // Enquanto i for menor ou igual a A,
                    // o laço continua.
                    //
                    // i++ significa aumentar i em 1.
                    for (i = 1; i <= (int)(a); i++) {

                        // Multiplica o resultado atual por i.
                        //
                        // Exemplo para 5:
                        //
                        // 1 * 1
                        // 1 * 2
                        // 2 * 3
                        // 6 * 4
                        // 24 * 5
                        //
                        // Resultado = 120
                        result = (result * i);
                    }
                }
            }


            // ====================================================
            // MOSTRANDO O RESULTADO
            // ====================================================

            // realToString(result)
            // transforma o número result em texto.
            //
            // stringConcat()
            // junta duas strings.
            //
            // Primeiro junta:
            //
            // "=====> Resultado: "
            //
            // com o resultado convertido para texto.
            //
            // Depois junta isso com "\\r\\n".
            //
            // Por fim, printf() mostra o texto na tela.
            printf("%s\n", stringConcat(stringConcat("=====> Resultado: ", realToString(result)), "\\r\\n"));


        } else {

            // ====================================================
            // OPÇÃO INVÁLIDA
            // ====================================================

            // Verifica se a opção não é 0.
            //
            // Isso é importante porque 0 significa sair.
            if (op != 0) {

                // Mostra uma mensagem de erro.
                printf("%s\n", "Opcao Invalida!");
            }
        }
    }


    // Retorna 0 indicando que o programa terminou normalmente.
    return 0;
}


