// ------------------------------------------------------------
// FUNÇÃO toInt
// ------------------------------------------------------------

// Recebe um texto e retorna um número inteiro.
int toInt(const char* text) {

    // atoi() transforma o texto em inteiro.
    //
    // Exemplo:
    // "123" -> 123
    return atoi(text);
}


// ------------------------------------------------------------
// FUNÇÃO toReal
// ------------------------------------------------------------

// Recebe um texto e retorna um número real.
double toReal(const char* text) {

    // atof() transforma o texto em double.
    //
    // Exemplo:
    // "3.14" -> 3.14
    return atof(text);
}


// ------------------------------------------------------------
// FUNÇÃO toString
// ------------------------------------------------------------

// Recebe um número double e retorna uma string.
const char* toString(double value) {

    // Cria um array de caracteres com espaço para 64 caracteres.
    //
    // static significa que esse espaço continua existindo
    // mesmo depois que a função terminar.
    static char buffer[64];

    // Converte o número para texto e coloca em buffer.
    //
    // %g é usado para mostrar um número real.
    snprintf(buffer, sizeof(buffer), "%g", value);

    // Retorna o texto armazenado em buffer.
    return buffer;
}


// ------------------------------------------------------------
// FUNÇÃO inputValue
// ------------------------------------------------------------

// Lê um número digitado pelo usuário.
double inputValue(void) {

    // Cria um array de caracteres para armazenar
    // temporariamente aquilo que o usuário digitou.
    char buffer[1024];


    // for(;;) é um loop infinito.
    //
    // Ele continuará repetindo até encontrar um return.
    for (;;) {

        // fgets() lê uma linha digitada pelo usuário.
        if (fgets(buffer, sizeof(buffer), stdin) == NULL) {

            // Se não conseguir ler,
            // retorna 0.0.
            return 0.0;
        }


        // strlen() calcula o tamanho da string.
        size_t len = strlen(buffer);


        // Verifica se existe uma quebra de linha no final.
        if (len > 0 && buffer[len - 1] == '\n') {

            // Troca o '\n' por '\0'.
            //
            // '\0' representa o final da string.
            buffer[len - 1] = '\0';
        }


        // Zera o indicador de erro.
        errno = 0;


        // Cria um ponteiro que será utilizado
        // pela função strtod().
        char* endptr;


        // Tenta transformar o texto em um número double.
        //
        // Exemplo:
        // "25.5" -> 25.5
        double value = strtod(buffer, &endptr);


        // Verifica se a conversão foi válida.
        //
        // endptr != buffer
        // significa que alguma coisa foi convertida.
        //
        // *endptr == '\0'
        // significa que não sobrou texto inválido.
        //
        // errno == 0
        // significa que não ocorreu erro.
        if (endptr != buffer && *endptr == '\0' && errno == 0) {

            // Se estiver tudo certo,
            // retorna o número.
            return value;
        }


        // Se o valor não for válido,
        // mostra uma mensagem de erro.
        fprintf(stderr, "Valore non valido. Inserire un numero.\n");

        // Como estamos dentro do for infinito,
        // o programa volta para o começo do loop
        // e pede outro número.
    }
}


// ------------------------------------------------------------
// FUNÇÃO stringConcat
// ------------------------------------------------------------

// Junta duas strings.
char* stringConcat(const char* s1, const char* s2) {

    // Calcula o tamanho da primeira string.
    //
    // Se s1 for NULL, considera tamanho 0.
    size_t len1 = (s1 != NULL) ? strlen(s1) : 0;


    // Calcula o tamanho da segunda string.
    //
    // Se s2 for NULL, considera tamanho 0.
    size_t len2 = (s2 != NULL) ? strlen(s2) : 0;


    // Reserva memória suficiente para guardar
    // as duas strings juntas + '\0'.
    char* result = (char*)malloc(len1 + len2 + 1);


    // Verifica se malloc() conseguiu reservar memória.
    if (result == NULL) {

        // Mostra uma mensagem de erro.
        fprintf(stderr, "Errore: memoria insufficiente in stringConcat.\n");

        // Encerra o programa.
        exit(EXIT_FAILURE);
    }


    // Se s1 existir...
    if (s1 != NULL) {

        // Copia s1 para result.
        memcpy(result, s1, len1);
    }


    // Se s2 existir...
    if (s2 != NULL) {

        // Copia s2 para depois de s1.
        //
        // result + len1 significa:
        // "comece depois do espaço ocupado por s1".
        memcpy(result + len1, s2, len2);
    }


    // Coloca o caractere de finalização da string.
    result[len1 + len2] = '\0';


    // Retorna a nova string.
    return result;
}


// ------------------------------------------------------------
// FUNÇÃO inputString
// ------------------------------------------------------------

// Lê uma string digitada pelo usuário.
char* inputString(void) {

    // Cria um espaço temporário para armazenar o texto.
    char buffer[1024];


    // Tenta ler uma linha.
    if (fgets(buffer, sizeof(buffer), stdin) == NULL) {

        // Se não conseguir ler,
        // reserva espaço para uma string vazia.
        char* empty = (char*)malloc(1);


        // Verifica se conseguiu reservar memória.
        if (empty == NULL) {

            // Mostra erro.
            fprintf(stderr, "Errore: memoria insufficiente in inputString.\n");

            // Encerra o programa.
            exit(EXIT_FAILURE);
        }


        // Coloca o final da string.
        empty[0] = '\0';


        // Retorna a string vazia.
        return empty;
    }


    // Calcula o tamanho do texto.
    size_t len = strlen(buffer);


    // Verifica se existe '\n' no final.
    if (len > 0 && buffer[len - 1] == '\n') {

        // Remove o '\n'.
        buffer[len - 1] = '\0';

        // Diminui o tamanho em 1.
        len--;
    }


    // Reserva memória suficiente para a string.
    //
    // +1 é para o '\0'.
    char* result = (char*)malloc(len + 1);


    // Verifica se conseguiu reservar memória.
    if (result == NULL) {

        // Mostra erro.
        fprintf(stderr, "Errore: memoria insufficiente in inputString.\n");

        // Encerra o programa.
        exit(EXIT_FAILURE);
    }


    // Copia o conteúdo de buffer para result.
    memcpy(result, buffer, len + 1);


    // Retorna a string.
    return result;
}


// ------------------------------------------------------------
// FUNÇÃO inputBool
// ------------------------------------------------------------

// Lê true ou false.
bool inputBool(void) {

    // Cria um pequeno espaço para guardar o texto.
    char buffer[32];


    // Loop infinito.
    for (;;) {

        // Lê uma linha.
        if (fgets(buffer, sizeof(buffer), stdin) == NULL) {

            // Se não conseguir ler,
            // retorna false.
            return false;
        }


        // Calcula o tamanho da string.
        size_t len = strlen(buffer);


        // Remove o '\n' do final.
        if (len > 0 && buffer[len - 1] == '\n') {

            buffer[len - 1] = '\0';

            len--;
        }


        // Variável que indica se existe espaço.
        //
        // 0 = não encontrou espaço.
        // 1 = encontrou espaço.
        int hasSpace = 0;


        // Percorre todos os caracteres do texto.
        for (size_t i = 0; i < len; i++) {

            // Verifica se o caractere atual é um espaço.
            if (buffer[i] == ' ') {

                // Marca que encontrou espaço.
                hasSpace = 1;

                // Para o for.
                break;
            }


            // Verifica se o caractere atual é TAB.
            if (buffer[i] == '\t') {

                // Marca que encontrou espaço.
                hasSpace = 1;

                // Para o for.
                break;
            }
        }


        // Se encontrou espaço ou TAB...
        if (hasSpace) {

            // Mostra uma mensagem de erro.
            fprintf(stderr, "Valore booleano non valido. Inserire true o false.\n");

            // Volta para o começo do loop.
            continue;
        }


        // ====================================================
        // VERIFICANDO A PALAVRA "true"
        // ====================================================

        // "true" possui 4 caracteres.
        if (len == 4) {

            // Começamos assumindo que é true.
            int isTrue = 1;


            // Verifica o primeiro caractere.
            //
            // Aceita 't' ou 'T'.
            if (buffer[0] != 't' && buffer[0] != 'T')
                isTrue = 0;


            // Verifica o segundo caractere.
            if (buffer[1] != 'r' && buffer[1] != 'R')
                isTrue = 0;


            // Verifica o terceiro caractere.
            if (buffer[2] != 'u' && buffer[2] != 'U')
                isTrue = 0;


            // Verifica o quarto caractere.
            if (buffer[3] != 'e' && buffer[3] != 'E')
                isTrue = 0;


            // Se todos os caracteres estiverem corretos...
            if (isTrue) {

                // Retorna true.
                return true;
            }
        }


        // ====================================================
        // VERIFICANDO A PALAVRA "false"
        // ====================================================

        // "false" possui 5 caracteres.
        if (len == 5) {

            // Começamos assumindo que é false.
            int isFalse = 1;


            // Verifica o primeiro caractere.
            if (buffer[0] != 'f' && buffer[0] != 'F')
                isFalse = 0;


            // Verifica o segundo caractere.
            if (buffer[1] != 'a' && buffer[1] != 'A')
                isFalse = 0;


            // Verifica o terceiro caractere.
            if (buffer[2] != 'l' && buffer[2] != 'L')
                isFalse = 0;


            // Verifica o quarto caractere.
            if (buffer[3] != 's' && buffer[3] != 'S')
                isFalse = 0;


            // Verifica o quinto caractere.
            if (buffer[4] != 'e' && buffer[4] != 'E')
                isFalse = 0;


            // Se todos os caracteres estiverem corretos...
            if (isFalse) {

                // Retorna false.
                return false;
            }
        }


        // Se não foi true nem false,
        // mostra uma mensagem de erro.
        fprintf(stderr, "Valore booleano non valido. Inserire true o false.\n");
    }
}


// ------------------------------------------------------------
// FUNÇÃO toChar
// ------------------------------------------------------------

// Recebe um código inteiro e transforma em caractere.
char* toChar(int code) {

    // Reserva espaço para:
    //
    // 1 caractere
    // +
    // 1 '\0'
    char* result = (char*)malloc(2);


    // Verifica se conseguiu reservar memória.
    if (result == NULL) {

        // Mostra erro.
        fprintf(stderr, "Errore: memoria insufficiente in toChar.\n");

        // Encerra o programa.
        exit(EXIT_FAILURE);
    }


    // Converte o número para char.
    result[0] = (char)code;


    // Coloca o final da string.
    result[1] = '\0';


    // Retorna o resultado.
    return result;
}


// ------------------------------------------------------------
// FUNÇÃO intToString
// ------------------------------------------------------------

// Transforma um número inteiro em string.
char* intToString(int value) {

    // Cria um espaço temporário para guardar o texto.
    char buffer[32];


    // Converte o inteiro para string.
    //
    // %d representa um inteiro.
    int len = snprintf(buffer, sizeof(buffer), "%d", value);


    // Verifica se ocorreu algum erro.
    if (len < 0) {

        // Mostra erro.
        fprintf(stderr, "Errore in intToString.\n");

        // Encerra o programa.
        exit(EXIT_FAILURE);
    }


    // Reserva memória suficiente para o texto.
    char* result = (char*)malloc((size_t)len + 1);


    // Verifica se conseguiu reservar memória.
    if (result == NULL) {

        // Mostra erro.
        fprintf(stderr, "Errore: memoria insufficiente in intToString.\n");

        // Encerra o programa.
        exit(EXIT_FAILURE);
    }


    // Copia o texto para a memória reservada.
    memcpy(result, buffer, (size_t)len + 1);


    // Retorna a string.
    return result;
}


// ------------------------------------------------------------
// FUNÇÃO realToString
// ------------------------------------------------------------

// Transforma um número real (double) em string.
char* realToString(double value) {

    // Cria um espaço temporário.
    char buffer[64];


    // Converte o double para texto.
    //
    // %g é utilizado para números reais.
    int len = snprintf(buffer, sizeof(buffer), "%g", value);


    // Verifica se ocorreu algum erro.
    if (len < 0) {

        // Mostra erro.
        fprintf(stderr, "Errore in realToString.\n");

        // Encerra o programa.
        exit(EXIT_FAILURE);
    }


    // Reserva memória suficiente para a string.
    char* result = (char*)malloc((size_t)len + 1);


    // Verifica se conseguiu reservar memória.
    if (result == NULL) {

        // Mostra erro.
        fprintf(stderr, "Errore: memoria insufficiente in realToString.\n");

        // Encerra o programa.
        exit(EXIT_FAILURE);
    }


    // Copia a string para a memória reservada.
    memcpy(result, buffer, (size_t)len + 1);


    // Retorna a string.
    return result;
}


