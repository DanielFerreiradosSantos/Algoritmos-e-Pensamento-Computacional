// ------------------------------------------------------------

// Transforma um booleano em string.
char* boolToString(bool value) {

    // Operador ternário.
    //
    // Se value for true:
    // src recebe "true".
    //
    // Se value for false:
    // src recebe "false".
    const char* src = value ? "true" : "false";


    // Calcula o tamanho da string.
    size_t len = strlen(src);


    // Reserva memória para a string.
    //
    // +1 é para o '\0'.
    char* result = (char*)malloc(len + 1);


    // Verifica se conseguiu reservar memória.
    if (result == NULL) {

        // Mostra erro.
        fprintf(stderr, "Errore: memoria insufficiente in boolToString.\n");

        // Encerra o programa.
        exit(EXIT_FAILURE);
    }


    // Copia a string para a memória reservada.
    memcpy(result, src, len + 1);


    // Retorna a string.
    return result;
}
