<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Calculadora Cientifica + IMC e Area"/>
        <attribute name="authors" value="Gemini"/>
        <attribute name="about" value="Calculadora Cientifica com Classificacao de IMC"/>
        <attribute name="saved" value="2026-09-05 11:47:00 "/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="op, i" type="Integer" array="False" size=""/>
            <declare name="a, b, result" type="Real" array="False" size=""/>
            <assign variable="op" expression="1"/>
            <while expression="op != 0">
                <output expression="&quot;=== Calculadora Cientifica + IMC e Area ===&quot;" newline="True"/>
                <output expression="&quot;1:Soma | 2:Subtracao | 3:Multiplicacao | 4:Divisao | 5:Potencia | 6:Modulo&quot;" newline="True"/>
                <output expression="&quot;7:Raiz | 8:Seno | 9:Cosseno | 10:Tangente | 11:Asin | 12:Acos | 13:Atan&quot;" newline="True"/>
                <output expression="&quot;14:Log10 | 15:Ln | 16:Exp | 17:Abs | 18:Int | 19:Sinal | 20:Fatorial&quot;" newline="True"/>
                <output expression="&quot;21:Calculo de IMC | 22:Area do Retangulo/Triangulo&quot;" newline="True"/>
                <output expression="&quot;0:Sair&quot;" newline="True"/>
                <output expression="&quot;--------------------------------------------------&quot;" newline="True"/>
                <output expression="&quot;Escolha a operacao (0 a 22):&quot;" newline="True"/>
                <input variable="op"/>
                <if expression="op &gt; 0 and op &lt;= 22">
                    <then>
                        <if expression="(op &gt;= 1 and op &lt;= 6) or op == 21 or op == 22">
                            <then>
                                <if expression="op == 21">
                                    <then>
                                        <output expression="&quot;Digite o peso (kg):&quot;" newline="True"/>
                                        <input variable="a"/>
                                        <output expression="&quot;Digite a altura (m):&quot;" newline="True"/>
                                        <input variable="b"/>
                                        <if expression="b &gt; 0">
                                            <then>
                                                <assign variable="result" expression="a / (b ^ 2)"/>
                                                <if expression="result &lt; 18.5">
                                                    <then>
                                                        <output expression="&quot;Classificacao: Abaixo do peso&quot;" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <if expression="result &lt; 25.0">
                                                            <then>
                                                                <output expression="&quot;Classificacao: Peso normal&quot;" newline="True"/>
                                                            </then>
                                                            <else>
                                                                <if expression="result &lt; 30.0">
                                                                    <then>
                                                                        <output expression="&quot;Classificacao: Sobrepeso (Acima do peso)&quot;" newline="True"/>
                                                                    </then>
                                                                    <else>
                                                                        <output expression="&quot;Classificacao: Obesidade&quot;" newline="True"/>
                                                                    </else>
                                                                </if>
                                                            </else>
                                                        </if>
                                                    </else>
                                                </if>
                                            </then>
                                            <else>
                                                <output expression="&quot;ERRO: Altura deve ser maior que zero!&quot;" newline="True"/>
                                                <assign variable="result" expression="0"/>
                                            </else>
                                        </if>
                                    </then>
                                    <else>
                                        <if expression="op == 22">
                                            <then>
                                                <output expression="&quot;Digite a Base:&quot;" newline="True"/>
                                                <input variable="a"/>
                                                <output expression="&quot;Digite a Altura:&quot;" newline="True"/>
                                                <input variable="b"/>
                                                <assign variable="result" expression="a * b"/>
                                            </then>
                                            <else>
                                                <output expression="&quot;Digite o valor de A:&quot;" newline="True"/>
                                                <input variable="a"/>
                                                <output expression="&quot;Digite o valor de B:&quot;" newline="True"/>
                                                <input variable="b"/>
                                                <if expression="op == 1">
                                                    <then>
                                                        <assign variable="result" expression="a + b"/>
                                                    </then>
                                                    <else/>
                                                </if>
                                                <if expression="op == 2">
                                                    <then>
                                                        <assign variable="result" expression="a - b"/>
                                                    </then>
                                                    <else/>
                                                </if>
                                                <if expression="op == 3">
                                                    <then>
                                                        <assign variable="result" expression="a * b"/>
                                                    </then>
                                                    <else/>
                                                </if>
                                                <if expression="op == 4">
                                                    <then>
                                                        <if expression="b != 0">
                                                            <then>
                                                                <assign variable="result" expression="a / b"/>
                                                            </then>
                                                            <else>
                                                                <output expression="&quot;ERRO: Divisao por zero!&quot;" newline="True"/>
                                                                <assign variable="result" expression="0"/>
                                                            </else>
                                                        </if>
                                                    </then>
                                                    <else/>
                                                </if>
                                                <if expression="op == 5">
                                                    <then>
                                                        <assign variable="result" expression="a ^ b"/>
                                                    </then>
                                                    <else/>
                                                </if>
                                                <if expression="op == 6">
                                                    <then>
                                                        <assign variable="result" expression="a % b"/>
                                                    </then>
                                                    <else/>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </then>
                            <else>
                                <output expression="&quot;Digite o valor de A:&quot;" newline="True"/>
                                <input variable="a"/>
                                <if expression="op == 7">
                                    <then>
                                        <assign variable="result" expression="sqrt(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 8">
                                    <then>
                                        <assign variable="result" expression="sin(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 9">
                                    <then>
                                        <assign variable="result" expression="cos(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 10">
                                    <then>
                                        <assign variable="result" expression="tan(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 11">
                                    <then>
                                        <assign variable="result" expression="arcsin(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 12">
                                    <then>
                                        <assign variable="result" expression="arccos(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 13">
                                    <then>
                                        <assign variable="result" expression="arctan(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 14">
                                    <then>
                                        <assign variable="result" expression="log10(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 15">
                                    <then>
                                        <assign variable="result" expression="log(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 16">
                                    <then>
                                        <assign variable="result" expression="exp(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 17">
                                    <then>
                                        <assign variable="result" expression="abs(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 18">
                                    <then>
                                        <assign variable="result" expression="int(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 19">
                                    <then>
                                        <assign variable="result" expression="sgn(a)"/>
                                    </then>
                                    <else/>
                                </if>
                                <if expression="op == 20">
                                    <then>
                                        <assign variable="result" expression="1"/>
                                        <for variable="i" start="1" end="int(a)" direction="inc" step="1">
                                            <assign variable="result" expression="result * i"/>
                                        </for>
                                    </then>
                                    <else/>
                                </if>
                            </else>
                        </if>
                        <output expression="&quot;=====&gt; Resultado: &quot; &amp; result &amp; &quot;\r\n&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="op != 0">
                            <then>
                                <output expression="&quot;Opcao Invalida!&quot;" newline="True"/>
                            </then>
                            <else/>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
</flowgorithm>
